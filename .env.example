# Режим: mock (за замовчуванням, синтетичні кабінети) або live (справжні API).
ADS_MODE=mock

# Telegram: бот від @BotFather і чат, куди слати звіти.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Довільний довгий рядок: Telegram надсилає його в заголовку вебхука, ним же підписані кнопки.
TELEGRAM_WEBHOOK_SECRET=
# Vercel Cron передає його в Authorization: Bearer ...
CRON_SECRET=
# Публічна адреса для посилання в повідомленні (на Vercel можна не задавати).
PUBLIC_URL=

# Groq: оцінка сумнівних пошукових запитів і текст тижневого звіту. Без ключа працюють правила і шаблон.
GROQ_API_KEY=

# Лише для ADS_MODE=live
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GADS_DEVELOPER_TOKEN=
GADS_ACCESS_TOKEN=
GADS_CUSTOMER_ID=
GADS_LOGIN_CUSTOMER_ID=